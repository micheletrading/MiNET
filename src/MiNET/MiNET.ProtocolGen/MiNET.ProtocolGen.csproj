<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiNET.ProtocolGen</RootNamespace>
    <AssemblyName>MiNET.ProtocolGen</AssemblyName>
  </PropertyGroup>

  <!-- Deliberately no reference to MiNET, same rule as MiNET.BlockGen: this tool writes MiNET's
       protocol registry and Cereal packet classes, so depending on them would mean it could only
       run while its own output already compiled. Its inputs are MCPE Protocol.xml (the T4 pdu
       manifest), the JSON schemas from a local BDS of the same version, and the roster and
       overrides files next to this project. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
